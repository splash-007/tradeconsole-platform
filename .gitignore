# ============================================================
# CryonFX Platform — Root .gitignore
# ============================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# Next.js build output
.next/
out/
dist/

# Test coverage
coverage/

# Environment files — NEVER commit real secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# Editor directories
.idea/
.vscode/
*.swp
*.swo

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# Database backups — NEVER commit
backups/
*.sql
*.dump
*.backup

# Secrets — NEVER commit
*.pem
*.key
*.cert
*.p12

# Build artifacts
apps/web/.next/
apps/api/dist/
packages/shared/dist/