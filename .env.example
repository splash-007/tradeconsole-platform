# CryptoVault Frontend Environment Configuration
# Copy to .env.local for development

# API Configuration
# BACKEND INTEGRATION: Set to your VPS API URL
NEXT_PUBLIC_API_BASE_URL=https://api.core-domain.com

# App URLs
NEXT_PUBLIC_APP_BASE_URL=https://app.core-domain.com
NEXT_PUBLIC_PUBLIC_SITE_URL=https://marketing-domain.com

# Data Mode: 'mock' for development, 'api' for production
NEXT_PUBLIC_DATA_MODE=mock

# NOTE: Never add secrets here with NEXT_PUBLIC_ prefix
# Backend secrets (DATABASE_URL, JWT_SECRET, etc.) belong ONLY on the VPS